TLAO_MAIL_ROOT=/opt/tlao-mail
MAIL_FQDN=mail.example.invalid
MAIL_PRIMARY_DOMAIN=example.invalid
MAIL_ALT_DOMAIN=example.net
LETSENCRYPT_EMAIL=ops@example.invalid
TZ=UTC
DKIM_SELECTOR=mail
CADDY_CERT_ISSUER=acme-v02.api.letsencrypt.org-directory
SNAPPYMAIL_HOSTS=webmail.example.invalid
SNAPPYMAIL_ALLOWED_DOMAINS=example.invalid
AUTOCONFIG_HOSTS=autoconfig.example.invalid,autodiscover.example.invalid
SNAPPYMAIL_IMAP_HOST=mail.example.invalid
SNAPPYMAIL_IMAP_PORT=993
SNAPPYMAIL_IMAP_SECURITY=ssl
SNAPPYMAIL_SMTP_HOST=mail.example.invalid
SNAPPYMAIL_SMTP_PORT=587
SNAPPYMAIL_SMTP_SECURITY=starttls
SNAPPYMAIL_LOGIN_MODE=email
SNAPPYMAIL_BRAND_THEME=Default
SNAPPYMAIL_BRAND_TITLE="TLÁO Mail"
SNAPPYMAIL_BRAND_LOADING_DESCRIPTION="TLÁO Mail"
SNAPPYMAIL_BRAND_FAVICON_URL=/snappymail/v/2.38.2/themes/Default/images/tlao-mark.svg
SNAPPYMAIL_BRAND_ALLOW_THEME_SWITCH=false

STALWART_ADMIN_USER=webadmin
STALWART_ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional offsite backup mirror. Store the bucket and one AWS auth method here.
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=tlao-mail/backups
BACKUP_S3_REGION=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_SESSION_TOKEN=
BACKUP_AWS_PROFILE=

SMTP_RELAY_ENABLED=false
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=

# Optional comma-separated dedicated SMTP account names that receive the
# Supabase-specific limits. Leave empty to preserve normal tenant behavior.
SUPABASE_SMTP_ACCOUNT_LIST=
